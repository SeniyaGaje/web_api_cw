# Copy this file to .env for local development. Never commit .env.

# Neon connection string for your DEV branch (Neon console > Connect, with connection pooling on, so the
# host name contains "-pooler").
# Change "sslmode=require" at the end to "sslmode=verify-full": the same encrypted, certificate-checked
# connection, without the security warning the pg driver prints for "require".
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full

# Secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Port for the local server (Vercel does not use it).
PORT=3000
